# git shortcut thing (could be more optimised but im lazy):
gits() {
	if [ -z "$1"]; then
		read -p "do you want to commit with today's date and time? " input
		# this handles all variations:
		if [[ "$input" =~ ^[Yy]([Ee][Ss]) ]]; then
			echo "pushing with today's date and time: $(date '+%Y-%m-%d %H:%M:%S') "
			git add . 
			git commit -m "$(date '+%Y-%m-%d %H:%M:%S')"
			git push
			
		else 
			echo "then... provide a commit title, bitch"
			return 1
		fi
	fi

	git add . 

	if [ -z "$2" ]; then
		git commit -m "$1"
	else 
		git commit -m "$1" -m "$2"
	fi

	git push
}

# fcd for faster file/folder lookup and cd
fcd() {
	local dir 
	dir=$(find ${1:-.} -path '*/.*' -prune -o -type d -print 2> /dev/null | fzf +m) &&
		cd "$dir"
}

# exercism stuff since i prefer to use the cli version over the website
ex() {
	exercism download --track="$1" --exercise="$2"
}

# a script to add .gitkeep in every empty dir in a project to protect the integrity of the projects layout
addfile() {
  for dir in */; do
    cd "$dir" || continue
    if [ -z "$(ls -A)" ]; then
      touch .gitkeep
    fi

    cd ..
  done
}

